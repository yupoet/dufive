{
  "name": "dufive",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "lint": "oxlint --ignore-pattern public/engine/rapfi/rapfi.js",
    "preview": "vite preview",
    "icons": "node scripts/generate-icons.mjs",
    "build:android": "npm run build && npx cap sync android && cd android && ANDROID_HOME=/data/android-sdk GRADLE_USER_HOME=${GRADLE_USER_HOME:-/tmp/dufive-gradle} ./gradlew assembleDebug --no-daemon && cp app/build/outputs/apk/debug/app-debug.apk ../dist/dufive.apk",
    "deploy:pages": "wrangler pages deploy dist --project-name ${CF_PAGES_PROJECT:-dufive} --branch main"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@fontsource/zcool-kuaile": "^5.2.8",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "playwright": "^1.61.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
